# Copy to backend/.env (local) or export in your host's dashboard (deployed).
VDC_DATABASE_URL=sqlite:///./vdc.db
# Set this to require an X-API-Key header on every call except /api/health.
VDC_API_KEY=
# Origins allowed to call the API from a browser (JSON list). Only needed when the web app is on another origin.
VDC_CORS_ORIGINS=["http://localhost:5173"]
VDC_LOG_LEVEL=INFO
